<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ecommerce.controllers.LoginController"
      alignment="CENTER" spacing="20"
      styleClass="root" stylesheets="@styles/login.css"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="40" left="50" right="50" bottom="40" />
    </padding>

    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="40" left="20" right="20" bottom="40" />
            </padding>
            
            <VBox alignment="CENTER" spacing="20" styleClass="main-container" maxWidth="500">
                <padding>
                    <Insets top="50" left="50" right="50" bottom="50" />
                </padding>

        <!-- Logo/Icon placeholder -->
        <Label text="🛒" style="-fx-font-size: 48px;" />
        
        <Label text="Smart E-Commerce" styleClass="title-label" />
        
        <Label text="Welcome back! Please sign in to continue" styleClass="subtitle-label" />

        <VBox fx:id="loginBox" spacing="18" styleClass="login-box" prefWidth="380">
            
            <!-- Email Field with Icon -->
            <VBox spacing="8">
                <Label text="📧  Email Address" styleClass="field-label" />
                <TextField fx:id="emailField" promptText="Enter your email" prefHeight="48" styleClass="input-field" />
            </VBox>
            
            <!-- Password Field with Icon -->
            <VBox spacing="8">
                <Label text="🔒  Password" styleClass="field-label" />
                <PasswordField fx:id="passwordField" promptText="Enter your password" prefHeight="48" styleClass="input-field" />
            </VBox>

            <!-- Sign In Button -->
            <Button text="Sign In" prefWidth="380" prefHeight="50" onAction="#handleSignIn" styleClass="primary-button" />
            
            <!-- Divider -->
            <HBox alignment="CENTER" spacing="15">
                <Separator prefWidth="120" />
                <Label text="OR" styleClass="divider-text" />
                <Separator prefWidth="120" />
            </HBox>
            
            <!-- Guest Button -->
            <Button text="Continue as Guest" prefWidth="380" prefHeight="50" styleClass="guest-button" onAction="#handleGuest" />
            
        </VBox>
        
        <!-- Register Section -->
        <HBox alignment="CENTER" spacing="8">
            <Label text="Don't have an account?" styleClass="register-text" />
            <Button text="Register Now" styleClass="register-button" onAction="#showRegisterForm" />
        </HBox>

        <!-- Error Label -->
        <Label fx:id="errorLabel" styleClass="error-label" />
        
        <!-- Registration Form (hidden by default) -->
        <VBox fx:id="registerBox" spacing="15" styleClass="login-box" prefWidth="380" visible="false" managed="false">
            <Label text="Create Account" styleClass="section-title" />
            
            <VBox spacing="6">
                <Label text="👤  Full Name" styleClass="field-label" />
                <TextField fx:id="nameField" promptText="Enter your full name" prefHeight="45" styleClass="input-field" />
            </VBox>
            
            <VBox spacing="6">
                <Label text="📧  Email Address" styleClass="field-label" />
                <TextField fx:id="registerEmailField" promptText="Enter your email" prefHeight="45" styleClass="input-field" />
            </VBox>
            
            <VBox spacing="6">
                <Label text="🔒  Password" styleClass="field-label" />
                <PasswordField fx:id="registerPasswordField" promptText="Create a password" prefHeight="45" styleClass="input-field" />
            </VBox>
            
            <VBox spacing="6">
                <Label text="📱  Phone Number" styleClass="field-label" />
                <TextField fx:id="phoneField" promptText="Enter your phone number" prefHeight="45" styleClass="input-field" />
            </VBox>
            
            <VBox spacing="6">
                <Label text="🏠  Address" styleClass="field-label" />
                <TextArea fx:id="addressField" promptText="Enter your address" prefHeight="80" styleClass="input-field" />
            </VBox>
            
            <Button text="Create Account" prefWidth="380" prefHeight="50" onAction="#handleRegister" styleClass="primary-button" />
            
            <HBox alignment="CENTER" spacing="8">
                <Label text="Already have an account?" styleClass="register-text" />
                <Button text="Sign In" styleClass="register-button" onAction="#showLoginForm" />
            </HBox>
        </VBox>

            </VBox>
        </VBox>
    </ScrollPane>

</VBox>
