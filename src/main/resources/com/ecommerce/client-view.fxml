<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecommerce.Controllers.ClientController"
            prefHeight="800.0" prefWidth="1200.0">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: #0f172a; -fx-padding: 14;">
            <Label text="SMART E-COMMERCE" textFill="white">
                <font><Font name="System Bold" size="26.0"/></font>
            </Label>
            <Label text="Browse products, add to cart, and check reviews" textFill="#cbd5e1">
                <font><Font size="14.0"/></font>
            </Label>
        </VBox>
    </top>

    <!-- MAIN CONTENT WITH TABS -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- PRODUCTS TAB -->
            <Tab text="Products" closable="false">
                <SplitPane dividerPositions="0.5" orientation="VERTICAL">
                    <VBox spacing="12" style="-fx-padding: 12;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtSearch" promptText="Search products..." prefWidth="220"/>
                            <Button text="Search" onAction="#handleSearch" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

                            <Label text="Category:"/>
                            <ComboBox fx:id="cmbFilterCategory" onAction="#handleFilter" prefWidth="160"/>

                            <Label text="Sort:"/>
                            <ComboBox fx:id="cmbSortBy" onAction="#handleSort" prefWidth="160"/>

                            <Button text="Refresh" onAction="#handleRefresh" style="-fx-background-color: #64748b; -fx-text-fill: white;"/>
                        </HBox>

                        <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProductId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colProductName" text="Product" prefWidth="260"/>
                                <TableColumn fx:id="colCategory" text="Category" prefWidth="150"/>
                                <TableColumn fx:id="colPrice" text="Price" prefWidth="110"/>
                                <TableColumn fx:id="colStock" text="Available" prefWidth="110"/>
                            </columns>
                        </TableView>

                        <HBox style="-fx-background-color: #f8fafc; -fx-padding: 8;">
                            <Label fx:id="lblStatus" text="Ready"/>
                        </HBox>
                    </VBox>

                    <!-- PRODUCT DETAILS PANEL -->
                    <VBox fx:id="productDetailsPanel" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;" visible="false" managed="false">
                        <Label text="Product Details" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        
                        <GridPane hgap="10" vgap="8" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 8;">
                            <Label text="Name:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="lblDetailName" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Description:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="lblDetailDescription" text="-" wrapText="true" maxWidth="400" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Price:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="lblDetailPrice" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Stock:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="lblDetailStock" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Quantity:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                <TextField fx:id="txtDetailQuantity" promptText="1" prefWidth="60"/>
                                <Button text="Add to Cart" onAction="#handleAddToCartFromDetails" style="-fx-background-color: #22c55e; -fx-text-fill: white;"/>
                            </HBox>
                        </GridPane>

                        <Label text="Reviews for this Product" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <TableView fx:id="productReviewTable" prefHeight="180">
                            <columns>
                                <TableColumn fx:id="colDetailReviewUser" text="Customer" prefWidth="150"/>
                                <TableColumn fx:id="colDetailRating" text="Rating" prefWidth="80"/>
                                <TableColumn fx:id="colDetailComment" text="Comment" prefWidth="450"/>
                            </columns>
                        </TableView>

                        <Label text="Cart Preview" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                        <TableView fx:id="cartPreviewTable" prefHeight="150">
                            <columns>
                                <TableColumn fx:id="colPreviewProduct" text="Product" prefWidth="200"/>
                                <TableColumn fx:id="colPreviewQty" text="Qty" prefWidth="60"/>
                                <TableColumn fx:id="colPreviewPrice" text="Price" prefWidth="100"/>
                                <TableColumn fx:id="colPreviewSubtotal" text="Subtotal" prefWidth="100"/>
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Cart Total:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblPreviewTotal" text="0.00" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                        </HBox>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- CART TAB -->
            <Tab text="Cart" closable="false">
                <VBox spacing="12" style="-fx-padding: 14;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Your Cart" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCartStatus" text=" " style="-fx-text-fill: #444;"/>
                    </HBox>

                    <GridPane hgap="12" vgap="10" style="-fx-padding: 10; -fx-background-color: #f6f8fa; -fx-background-radius: 10;">
                        <Label text="Product" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cmbCartProduct" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Quantity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtCartQuantity" promptText="1" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                            <Button text="Add to Cart" onAction="#handleAddToCart" style="-fx-background-color: #22c55e; -fx-text-fill: white;"/>
                            <Button text="Remove Selected" onAction="#handleRemoveCartItem" style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
                        </HBox>
                    </GridPane>

                    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCartProduct" text="Product" prefWidth="260"/>
                            <TableColumn fx:id="colCartDescription" text="Description" prefWidth="260"/>
                            <TableColumn fx:id="colCartQty" text="Qty" prefWidth="80"/>
                            <TableColumn fx:id="colCartPrice" text="Price" prefWidth="110"/>
                            <TableColumn fx:id="colCartSubtotal" text="Subtotal" prefWidth="130"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Label text="Total:" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCartTotal" text="0.00" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                        <Button text="Checkout" onAction="#handleCheckout" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- REVIEWS TAB -->
            <Tab text="Reviews" closable="false">
                <VBox spacing="10" style="-fx-padding: 12;">
                    <Label text="Customer Reviews" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                    <TableView fx:id="reviewTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colReviewId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colReviewProduct" text="Product" prefWidth="220"/>
                            <TableColumn fx:id="colReviewUser" text="Customer" prefWidth="150"/>
                            <TableColumn fx:id="colRating" text="Rating" prefWidth="90"/>
                            <TableColumn fx:id="colComment" text="Comment" prefWidth="380"/>
                        </columns>
                    </TableView>
                    <TextArea fx:id="txtReviewDetails" promptText="Select a review to view details" prefRowCount="4" editable="false"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
