<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ecommerce.controllers.PerformanceReportController"
      spacing="15" style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <Label text="Performance Analysis Dashboard" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    
    <Label text="Generate comprehensive performance reports comparing pre- and post-optimization metrics"
           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" wrapText="true" />
    
    <Separator />
    
    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="runBenchmarkButton" text="🚀 Run Benchmarks" 
                onAction="#handleRunBenchmark"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand;" />
        
        <Button fx:id="saveReportButton" text="💾 Save Report" 
                onAction="#handleSaveReport"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand;" />
    </HBox>
    
    <!-- Report Output -->
    <VBox VBox.vgrow="ALWAYS">
        <Label text="Report Output:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <TextArea fx:id="reportOutput" editable="false" wrapText="false"
                  style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 12px;"
                  VBox.vgrow="ALWAYS" prefHeight="500">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10" />
            </padding>
        </TextArea>
    </VBox>
    
    <!-- Info Panel -->
    <VBox spacing="5" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="ℹ️ About This Tool" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
        <Label text="• Measures query execution times before and after optimization" wrapText="true" />
        <Label text="• Tests database indexes, caching, and connection pooling" wrapText="true" />
        <Label text="• Generates detailed reports with methodology and findings" wrapText="true" />
        <Label text="• Exports reports in Markdown format for documentation" wrapText="true" />
    </VBox>
    
</VBox>
